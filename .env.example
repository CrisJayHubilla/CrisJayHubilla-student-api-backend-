# Never commit your real .env file or share your MongoDB password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=LabAttendanceDB
MONGODB_STUDENT_COLLECTION=students
# Use the exact existing collection name that contains attendance records.
MONGODB_ATTENDANCE_COLLECTION=attendance
# Temporary demo setting. Later replace * with your deployed frontend URL(s).
CORS_ORIGINS=*
PORT=3000
